{% extends 'base.html.twig' %}

{% block title %}Forgot Password - Theatro INSAT{% endblock %}

{% block meta_description %}
    Request a Theatro INSAT password reset code.
{% endblock %}

{% block body_class %}page-auth page-forgot-password{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="{{ asset('legacy/css/auth.css') }}">
{% endblock %}

{% block body %}
    <div id="star-container"></div>

    <section class="auth-page">
        <div class="auth-container">
            <div class="auth-header">
                <span class="auth-brand">Theatro</span>
                <span class="auth-subtitle">Password Reset</span>
                <p class="auth-description">Enter your account email and we will send a six-digit reset code.</p>
            </div>

            {{ form_start(form, {'attr': {'class': 'auth-form', 'novalidate': 'novalidate'}}) }}
                {{ form_errors(form) }}

                <div class="form-group">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                <button type="submit" class="auth-btn">Send Code</button>
            {{ form_end(form) }}

            <div class="auth-footer">
                <p>Remember your password? <a href="{{ path('app_login') }}">Sign in</a></p>
            </div>
        </div>
    </section>
{% endblock %}
