<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Password Reset Code</title>
    </head>
    <body style="margin:0;padding:0;background:#0a0a0a;font-family:Arial,Helvetica,sans-serif;">
        <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#0a0a0a;padding:48px 20px;">
            <tr>
                <td align="center">
                    <table width="560" cellpadding="0" cellspacing="0" role="presentation" style="max-width:560px;background:#111;border:1px solid rgba(255,255,255,0.14);padding:40px;color:#fff;">
                        <tr>
                            <td style="padding-bottom:22px;border-bottom:1px solid rgba(255,255,255,0.1);">
                                <p style="margin:0;font-size:32px;font-weight:700;letter-spacing:2px;color:#fff;">Theatro</p>
                                <p style="margin:6px 0 0;font-size:11px;letter-spacing:3px;color:rgba(255,255,255,0.45);text-transform:uppercase;">Password Reset</p>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding:26px 0 18px;">
                                <p style="font-size:15px;line-height:1.7;color:rgba(255,255,255,0.78);margin:0 0 10px;">
                                    Hi {{ firstname ?: 'there' }},
                                </p>
                                <p style="font-size:14px;line-height:1.7;color:rgba(255,255,255,0.62);margin:0;">
                                    Use this code to reset your Theatro INSAT password. It expires at {{ expiresAt|date('H:i T') }}.
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="padding:12px 0 32px;">
                                <div style="display:inline-block;padding:20px 34px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.24);color:#fff;font-size:34px;font-weight:700;letter-spacing:10px;font-family:Consolas,monospace;">
                                    {{ code|slice(0, 3) }} {{ code|slice(3, 3) }}
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-top:22px;border-top:1px solid rgba(255,255,255,0.1);">
                                <p style="font-size:12px;color:rgba(255,255,255,0.38);margin:0;line-height:1.6;">
                                    If you did not request this reset, you can ignore this email. Never share this code with anyone.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
