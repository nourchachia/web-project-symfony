{% extends 'base.html.twig' %}

{% block title %}THEATRO - The Official Theatre Club of INSAT{% endblock %}

{% block meta_description %}
    Theatro INSAT - Where Art Meets Innovation. The official theatre club of INSAT since 2003.
{% endblock %}

{% block body_class %}page-home page-home-legacy{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('legacy/css/home.css') }}">
{% endblock %}

{% block body %}
<div id="star-container"></div>
<section class="hero" id="home">
        <div class="fog-stream flow-right">
            <div class="fog-segment"></div>
            <div class="fog-segment"></div>
            <div class="fog-segment"></div>
        </div>

        <div class="fog-stream flow-left">
            <div class="fog-segment"></div>
            <div class="fog-segment"></div>
            <div class="fog-segment"></div>
        </div>

        <div class="spotlight"></div>
        <div class="hero-content">
            <p class="welcome-text">Welcome to the stage</p>
            <h1 class="main-title">THEATRO</h1>
            <p class="tagline">Dream. Act. Inspire...</p>
            <div class="hero-buttons">
                <a href="#shows" class="btn btn-primary">View Shows</a>
                {% if not app.user %}
                    <a href="{{ path('app_registration_new') }}" class="btn btn-secondary join-cta">Join Us</a>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="book-show">
        <div class="book-content">
            <h2 class="book-title">Witness the <span class="italic-text">Magic</span></h2>
            <p class="book-tagline">Reserve your place in history. Every seat tells a story.</p>
            <a href="#shows" class="btn btn-primary">Book Show</a>
        </div>
    </section>

    <!-- About Us Section -->
    <section class="about" id="about">
        <!-- Step Into the World Heading -->
        <div class="about-intro">
            <span class="section-label">ABOUT US</span>
            <h2 class="section-hero-title">Step Into the World of <br><em class="italic-text">Theatro INSAT</em></h2>
        </div>

        <!-- Who Are We + Stats -->
        <div class="about-container">
            <div class="about-text-content">
                <span class="subsection-label">WHO ARE WE</span>
                <h3 class="about-heading">More Than <br><span class="italic-text">Just Acting</span></h3>
                <p class="about-description">Theatro INSAT is the official theater club of INSAT. Founded in 2003 by
                    passionate students, it provides a creative space where art meets innovation.
                    The club brings together young talents who share a love for acting, directing, and stage
                    performance, offering them opportunities to express themselves and showcase their creativity.</p>
                <p class="about-description">Over the years, Theatro INSAT has expanded into a dynamic structure with
                    several key departments: Acting, Writing, Music, Dance and Media.
                    Through plays, workshops, and cultural events, it has become a vibrant community that celebrates
                    artistic expression and teamwork.
                </p>
            </div>
            <div class="about-stats-grid">
                <div class="stat-card">
                    <span class="stat-plus">+</span><span class="stat-number" data-target="30">0</span>
                    <span class="stat-label">Productions</span>
                </div>
                <div class="stat-card">
                    <span class="stat-plus">+</span><span class="stat-number" data-target="200">0</span>
                    <span class="stat-label">Members</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number" data-target="23">0</span>
                    <span class="stat-label">Years Active</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number" data-target="10">0</span>
                    <span class="stat-label">Awards Won</span>
                </div>
            </div>
        </div>

        <!-- Timeline -->
        <div class="timeline-container">
            <div class="timeline-line"></div>
            <div class="timeline-milestone" style="left: 10%;">
                <div class="milestone-dot"></div>
                <div class="milestone-year">2003</div>
                <div class="milestone-text">Club Foundation</div>
            </div>
            <div class="timeline-milestone" style="left: 50%;">
                <div class="milestone-dot"></div>
                <div class="milestone-year">2016</div>
                <div class="milestone-text">First Edition of JTI</div>
                <div class="milestone-subtext">Our Most Important Event</div>
            </div>
            <div class="timeline-milestone" style="left: 90%;">
                <div class="milestone-dot"></div>
                <div class="milestone-year">2026</div>
                <div class="milestone-text">Still Going Strong</div>
            </div>
        </div>

        <!-- Polaroid Gallery -->
        <div class="polaroid-gallery">
            <div class="polaroid">
                <div class="polaroid-img" style="background-image: url('{{ asset('legacy/assets/g1.jpg') }}');"></div>
                <div class="polaroid-caption">2023</div>
            </div>
            <div class="polaroid">
                <div class="polaroid-img" style="background-image: url('{{ asset('legacy/assets/g2.jpg') }}');"></div>
                <div class="polaroid-caption">2025</div>
            </div>
            <div class="polaroid">
                <div class="polaroid-img" style="background-image: url('{{ asset('legacy/assets/g3.jpg') }}');"></div>
                <div class="polaroid-caption">2025</div>
            </div>
            <div class="polaroid">
                <div class="polaroid-img" style="background-image: url('{{ asset('legacy/assets/g4.jpg') }}');"></div>
                <div class="polaroid-caption">2025</div>
            </div>
        </div>
    </section>

    <!-- Departments Section -->
    <section class="departments" id="departments">
        <span class="section-label">OUR DEPARTMENTS</span>
        <h2 class="section-title">5 Departments</h2>

        <!-- Department 1: Acting -->
        <div class="department-row">
            <div class="department-bg-text">ACTING</div>
            <div class="department-content">
                <div class="department-text">
                    <p>The Acting Department is where creativity meets performance — a space to explore voice, movement,
                        and character
                        while bringing stories to life on stage and screen.</p>
                </div>
                <div class="department-visual">
                    <img src="{{ asset('legacy/assets/acting.png') }}" alt="Acting" class="department-silhouette">
                </div>
            </div>
        </div>

        <!-- Department 2: Music -->
        <div class="department-row">
            <div class="department-bg-text">MUSIC</div>
            <div class="department-content reverse">
                <div class="department-visual">
                    <img src="{{ asset('legacy/assets/music.png') }}" alt="Music" class="department-silhouette">
                </div>
                <div class="department-text">
                    <p>The Music Department is where passion meets rhythm ,a place to create, perform, and bring harmony
                        to life.</p>
                </div>
            </div>
        </div>

        <!-- Department 3: Dance -->
        <div class="department-row">
            <div class="department-bg-text">DANCING</div>
            <div class="department-content reverse">
                <div class="department-visual">
                    <img src="{{ asset('legacy/assets/dancing.png') }}" alt="Dance" class="department-silhouette">
                </div>
                <div class="department-text">
                    <p>The Dancing Department is where movement becomes art, a space to express, connect, and tell
                        stories through rhythm and motion.</p>
                </div>
            </div>
        </div>

        <!-- Department 4: Writing -->
        <div class="department-row">
            <div class="department-bg-text">WRITING</div>
            <div class="department-content">
                <div class="department-text">
                    <p>The Writing Department is where ideas turn into powerful stories,
                        a space to craft words, explore creativity, and give voice to imagination.</p>
                </div>
                <div class="department-visual">
                    <img src="{{ asset('legacy/assets/writing.png') }}" alt="Writing" class="department-silhouette">
                </div>
            </div>
        </div>

        <!-- Department 5: media -->
        <div class="department-row">
            <div class="department-bg-text">MEDIA</div>
            <div class="department-content">
                <div class="department-text">
                    <p>The Media Department transforms moments into stories, the stage for visual storytelling.</p>
                </div>
                <div class="department-visual">
                    <img src="{{ asset('legacy/assets/image.png') }}" alt="Media" class="department-silhouette">
                </div>
            </div>
        </div>
    </section>

    <!-- Activities Section -->
    <section class="activities" id="activities">
        <span class="section-label">WHAT WE DO</span>
        <h2 class="section-title">Our Activities</h2>

        <div class="activities-grid">
            <div class="polaroid activity-polaroid video-polaroid">
                <div class="polaroid-img">
                    <video class="polaroid-video" loop muted playsinline data-start-time="0">
                        <source src="{{ asset('legacy/assets/workshops.mp4') }}" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <div class="polaroid-caption">Workshops</div>
            </div>
            <div class="polaroid activity-polaroid video-polaroid">
                <div class="polaroid-img">
                    <video class="polaroid-video" loop muted playsinline data-start-time="0">
                        <source src="{{ asset('legacy/assets/plays.mp4') }}" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <div class="polaroid-caption">Plays</div>
            </div>
            <div class="polaroid activity-polaroid video-polaroid">
                <div class="polaroid-img">
                    <video class="polaroid-video" loop muted playsinline data-start-time="1">
                        <source src="{{ asset('legacy/assets/teambuilding.mp4') }}" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <div class="polaroid-caption">Team-building</div>
            </div>
        </div>
    </section>

    <!-- Guests of Honour Section -->
    <section class="guests" id="guests">
        <h2 class="section-title">Guests of Honour</h2>

        <div class="guests-grid">
            <div class="polaroid">
                <div class="polaroid-img" style="background-image: url('{{ asset('legacy/assets/guest1.jpg') }}');"></div>
                <div class="polaroid-caption">Chedli Arfaoui</div>
            </div>
            <div class="polaroid">
                <div class="polaroid-img" style="background-image: url('{{ asset('legacy/assets/guest2.jpg') }}');"></div>
                <div class="polaroid-caption">Nadia Bousetta</div>
            </div>
            <div class="polaroid">
                <div class="polaroid-img" style="background-image: url('{{ asset('legacy/assets/guest3.jpg') }}');"></div>
                <div class="polaroid-caption">Khaled Bouzid</div>
            </div>
            <div class="polaroid">
                <div class="polaroid-img" style="background-image: url('{{ asset('legacy/assets/guest4.jpg') }}');"></div>
                <div class="polaroid-caption">Fatma Ben Saïdane</div>
            </div>
            <div class="polaroid">
                <div class="polaroid-img" style="background-image: url('{{ asset('legacy/assets/guest5.jpg') }}');"></div>
                <div class="polaroid-caption">Hichem Rostom</div>
            </div>
            <div class="polaroid">
                <div class="polaroid-img" style="background-image: url('{{ asset('legacy/assets/guest.jpg') }}');"></div>
                <div class="polaroid-caption">Tawfik Bahri</div>
            </div>
        </div>
    </section>

    <!-- Media Presence Section -->
    <section class="media-presence" id="media">
        <h2 class="section-title">Media Presence</h2>

        <div class="media-logos">
            <div class="media-item">
                <img src="{{ asset('legacy/assets/rtci.png') }}" alt="RTCI" class="media-logo-img">
                <span class="media-logo">RTCI</span>
            </div>
            <div class="media-item">
                <img src="{{ asset('legacy/assets/ifm.png') }}" alt="IFM" class="media-logo-img">
                <span class="media-logo">IFM</span>
            </div>
            <div class="media-item">
                <img src="{{ asset('legacy/assets/radiomed.png') }}" alt="RadioMed" class="media-logo-img">
                <span class="media-logo">RadioMed</span>
            </div>
            <div class="media-item">
                <img src="{{ asset('legacy/assets/wataniya.png') }}" alt="Wataniya TV" class="media-logo-img">
                <span class="media-logo">Wataniya TV</span>
            </div>
            <div class="media-item">
                <img src="{{ asset('legacy/assets/expressfm.png') }}" alt="Express FM" class="media-logo-img">
                <span class="media-logo">Express FM</span>
            </div>
            <div class="media-item">
                <img src="{{ asset('legacy/assets/mosaique.png') }}" alt="Mosaïque FM" class="media-logo-img">
                <span class="media-logo">Mosaïque FM</span>
            </div>
        </div>
    </section>

    <div class="upcoming-shows">
        <h1 class="title-upcoming-shows" id="shows">Upcoming Shows</h1>
        <div class="shows">
            <div class="show">
                <img src="{{ asset('legacy/assets/eighty.jpeg') }}" alt="Eighty Show" loop>
                <div class="text">
                    <h2 class="titles">3am-ba3d-80</h2>
                    <p class="desc">3am-Ba3d-80, a compelling blend of comedy and tragedy, will be performed on
                        Wednesday, n month, 2000, at the INSAT auditorium. This powerful piece explores a profound
                        social issue, confronting truths that make you think, laugh, and reflect. Don’t miss the chance
                        to experience a story
                        that stays with you long after the curtain falls.
                    </p>
                </div>
                <button><a class="book-button" href="{{ path('app_booking_index') }}">Book Now</a></button>
            </div>
            <div class="show">
                <img src="{{ asset('legacy/assets/fazaa.png') }}" alt="Fazaa Show">
                <div class="text">
                    <h2 class="titles">El-Faz3a</h2>
                    <p class="desc">El-Faz3a, a compelling blend of comedy and tragedy, will be performed on Wednesday,
                        March 3, 2025, at the INSAT auditorium. This powerful piece explores a profound social issue,
                        confronting truths that make you think, laugh, and reflect. Don’t miss the chance to experience
                        a story
                        that stays with you long after the curtain falls.
                </div>
                <button><a class="book-button" href="{{ path('app_booking_index') }}">Book Now</a></button>
            </div>
            <div class="show">
                <img src="{{ asset('legacy/assets/damous.jpeg') }}" alt="Damous Show">
                <div class="text">
                    <h2 class="titles">El-Damous</h2>
                    <p class="desc">El-Damous, a compelling blend of comedy and tragedy, will be performed on Wednesday,
                        n month, 2000, at the INSAT auditorium. This powerful piece explores a profound social issue,
                        confronting truths that make you think, laugh, and reflect. Don’t miss the chance to experience
                        a story
                        that stays with you long after the curtain falls.
                    </p>
                </div>
                <button><a class="book-button" href="{{ path('app_booking_index') }}">Book Now</a></button>
            </div>

        </div>
    </div>

    <!-- Board Members Section -->
    <section class="board-section" id="board">
        <span class="section-label">BEHIND THE SCENES</span>
        <h2 class="section-title">Our Board</h2>
        <p class="section-description" style="margin-bottom: 60px;">The passionate individuals who keep Theatro INSAT
            running behind the curtain.</p>

        <div class="board-grid">
            <div class="board-card">
                <div class="board-avatar">
                    <img src="{{ asset('legacy/assets/presidente.png') }}" alt="Oumayma Ben Saad" class="board-photo">
