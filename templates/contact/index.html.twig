{% extends 'base.html.twig' %}

{% block title %}Contact Us - Theatro INSAT{% endblock %}

{% block meta_description %}
    Get in touch with Theatro INSAT, the official theatre club of INSAT.
{% endblock %}

{% block body_class %}page-contact{% endblock %}

{% block stylesheets %}
    <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700&family=Marcellus&family=Pinyon+Script&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('legacy/css/contact.css') }}">
{% endblock %}

{% block body %}
    <div id="star-container"></div>

    <section class="contact-section">
        <span class="section-label">Reach Out</span>
        <h1 class="section-hero-title">Contact Us</h1>

        <div class="contact-container">
            <div class="contact-form-wrapper">
                <h2 class="contact-subtitle">Get in touch</h2>

                {{ form_start(form, {
                    attr: {
                        class: 'contact-form',
                        novalidate: 'novalidate'
                    }
                }) }}
                    {{ form_errors(form) }}

                    <div class="form-group">
                        {{ form_label(form.fullname) }}
                        {{ form_widget(form.fullname) }}
                        {{ form_errors(form.fullname) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.email) }}
                        {{ form_widget(form.email) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.message) }}
                        {{ form_widget(form.message) }}
                        {{ form_errors(form.message) }}
                    </div>

                    <button type="submit" class="submit-btn">
                        Submit <i class="fas fa-paper-plane" aria-hidden="true"></i>
                    </button>
                {{ form_end(form) }}
            </div>

            <div class="map-wrapper">
                <a href="https://maps.google.com/?q=INSAT,Tunisia" target="_blank" rel="noopener" class="map-link">View larger map</a>
                <iframe
                    title="INSAT location map"
                    width="100%"
                    height="500"
                    loading="lazy"
                    src="https://maps.google.com/maps?q=36.842898,10.196162&hl=en&z=17&amp;output=embed">
                </iframe>
            </div>
        </div>
    </section>

    <section class="sponsors-section">
        <h2 class="section-title">They Trusted Us</h2>
        <div class="sponsors-slider">
            <div class="sponsors-track">
                {% set sponsors = [
                    { file: 'madchips.png', name: 'MadChips' },
                    { file: 'pointm.png', name: 'PointM' },
                    { file: 'twinpeaks.png', name: 'Twin Peaks' },
                    { file: 'paraessentiel.png', name: 'ParaEssentiel' },
                    { file: 'paintball.png', name: 'Paintball' },
                    { file: 'chocoland.png', name: 'Chocoland' },
                    { file: 'madchips.png', name: 'MadChips' },
                    { file: 'pointm.png', name: 'PointM' },
                    { file: 'twinpeaks.png', name: 'Twin Peaks' },
                    { file: 'paraessentiel.png', name: 'ParaEssentiel' },
                    { file: 'paintball.png', name: 'Paintball' },
                    { file: 'chocoland.png', name: 'Chocoland' }
                ] %}

                {% for sponsor in sponsors %}
                    <div class="sponsor-card">
                        <img src="{{ asset('legacy/assets/' ~ sponsor.file) }}" alt="{{ sponsor.name }}">
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
