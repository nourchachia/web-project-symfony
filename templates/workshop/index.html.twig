{% extends 'base.html.twig' %}

{% block title %}Workshops - Theatro INSAT{% endblock %}

{% block meta_description %}
    Theatro INSAT workshops - Acting, Dancing and more. Learn, Grow, Perform.
{% endblock %}

{% block body_class %}page-workshops{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('legacy/css/home.css') }}">
    <link rel="stylesheet" href="{{ asset('legacy/css/workshops.css') }}">
{% endblock %}

{% block body %}
    <!-- Stars Background -->
    <div class="stars-background"></div>

    <!-- Workshops Section -->
    <section class="workshops-section">
        <h5 class="section-title"> AVAILABLE WORKSHOPS</h5>
        <h2 class="section-subtitle">Learn. Grow. Perform</h2>
        <h1 class="section-description">From raw talents to stage ready stars. Discover your inner performer with our
            comprehensive workshops.</h1>

        <!-- Workshop Information Sections -->
        <div class="workshops-info-container" id="workshops-info-container" data-workshops-url="{{ path('api_workshops_list') }}" aria-live="polite">
            <div class="workshops-state">Loading workshops...</div>
        </div>

        <!-- Unified Registration Form -->
        <div class="unified-form-container">
            <h3 class="form-section-title">Workshop Registration</h3>

            <div class="membership-notice">
                <svg class="notice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <p>These workshops are exclusively accessible to Theatro INSAT club members only</p>
            </div>

            <form class="workshop-form" id="unified-workshop-form" data-registration-url="{{ path('api_workshop_registrations_create') }}">
                <div class="form-group">
                    <label for="workshop-selection">Select Workshop *</label>
                    <select id="workshop-selection" name="workshop" required>
                        <option value="">Loading workshops...</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Are you sure you're coming?</label>
                    <div class="rating-container">
                        <input type="radio" id="star5" name="rating" value="5" />
                        <label for="star5" class="star">★</label>
                        <input type="radio" id="star4" name="rating" value="4" />
                        <label for="star4" class="star">★</label>
                        <input type="radio" id="star3" name="rating" value="3" />
                        <label for="star3" class="star">★</label>
                        <input type="radio" id="star2" name="rating" value="2" />
                        <label for="star2" class="star">★</label>
                        <input type="radio" id="star1" name="rating" value="1" />
                        <label for="star1" class="star">★</label>
                    </div>
                    <span class="rating-text">Select stars to rate your commitment level</span>
                </div>

                <button type="submit" class="btn btn-primary submit-btn">Register for Workshop</button>
            </form>
        </div>
    </section>


{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('legacy/js/workshops.js') }}" defer></script>
{% endblock %}
