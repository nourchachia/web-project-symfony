<nav class="site-navbar">
    <a href="{{ path('app_home_index') }}" class="site-navbar__logo" aria-label="Theatro INSAT home">
        <img src="{{ asset('legacy/assets/theatro-logo.png') }}" alt="Theatro INSAT logo">
    </a>

    <ul class="site-navbar__links">
        <li><a href="{{ path('app_home_index') }}">Home</a></li>
        <li><a href="{{ app.request.attributes.get('_route') == 'app_home_index' ? '#about' : path('app_home_index') ~ '#about' }}">About</a></li>
        <li><a href="{{ app.request.attributes.get('_route') == 'app_home_index' ? '#shows' : path('app_home_index') ~ '#shows' }}">Shows</a></li>
        <li><a href="{{ path('app_booking_index') }}">Booking</a></li>
        {% if is_granted('ROLE_USER') %}
            <li><a href="{{ path('app_workshop_index') }}">Workshops</a></li>
        {% endif %}
        {% if not app.user %}
            <li><a href="{{ path('app_registration_new') }}">Join Us</a></li>
        {% endif %}
        <li><a href="{{ path('app_contact_index') }}">Contact</a></li>
    </ul>

    <div class="site-navbar__auth">
        {% if app.user %}
            <a href="{{ path('app_logout') }}" class="site-navbar__button">Logout</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="site-navbar__button">Login</a>
        {% endif %}
    </div>
</nav>
